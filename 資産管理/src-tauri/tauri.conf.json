{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AquaAsset",
  "version": "0.1.0",
  "identifier": "com.aquaasset.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AquaAsset",
        "width": 1280,
        "height": 800,
        "minWidth": 1080,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Finance",
    "shortDescription": "ローカルで安全に資産を管理",
    "longDescription": "預金、株式、投資信託、暗号資産を端末内で一元管理するデスクトップアプリです。",
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
